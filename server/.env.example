# JWT 서명 키 (운영 시 반드시 변경)
SECRET_KEY=change-me
# SQLite 기본. PostgreSQL 사용 시 postgresql+psycopg://user:pw@host/db
DATABASE_URL=sqlite:///./storage/app.db
# 비워두면 AI 기능은 규칙 기반(오프라인) 모드로 동작
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 업로드 원본 자동 삭제 기간(일)
UPLOAD_RETENTION_DAYS=30
# 한글 PDF 폰트 (Windows 기본: 맑은고딕)
PDF_FONT_PATH=C:/Windows/Fonts/malgun.ttf
# 비워두면 메일은 실제 발송 없이 MOCK 모드
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CORS_ORIGINS=http://localhost:3000
