# 세션 CSRF·보안 식별자 서명 키 (운영 시 32자 이상 무작위 비밀값)
SECRET_KEY=change-me
# 기존 관리자 이관용 이메일 목록. 런타임 권한은 library_admins의 승인된 사용자 ID로 결정
LIBRARY_ADMIN_EMAILS=
# SQLite 기본. PostgreSQL 사용 시 postgresql+psycopg://user:pw@host/db
DATABASE_URL=sqlite:///./storage/app.db
# 비워두면 AI 기능은 규칙 기반(오프라인) 모드로 동작
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 업로드 원본 자동 삭제 기간(일)
UPLOAD_RETENTION_DAYS=30
# 한글 PDF 폰트 (Windows 기본: 맑은고딕)
PDF_FONT_PATH=C:/Windows/Fonts/malgun.ttf
# 비워두면 메일은 실제 발송 없이 MOCK 모드
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CORS_ORIGINS=http://localhost:3000

# 클라우드는 필수: DB와 별도 보관하는 Fernet 키. 로컬은 storage/.data-encryption.key 자동 생성
DATA_ENCRYPTION_KEYS=
# Secret volume의 절대 경로. 위 DATA_ENCRYPTION_KEYS와 둘 중 하나만 설정
# DATA_ENCRYPTION_KEY_FILE=/run/secrets/capstone-data-keys
# 클라우드 정기 삭제 작업 인증용 무작위 비밀값 (32자 이상)
CRON_SECRET=
